# Vorlage für die lokale .env. Nicht von Hand kopieren: "make setup" legt .env an
# und füllt die leeren Geheimnisse mit Zufallswerten. Die .env kommt nie ins Repository.
#
# Wird von Docker Compose (Ports, Datenbank) und von Shopware gelesen.

###> Docker ###
SHOP_PORT=8000
MAILPIT_PORT=8025
DB_PASSWORT=
DB_ROOT_PASSWORT=
###< Docker ###

###> Shopware ###
APP_ENV=dev
APP_URL=http://localhost:8000
APP_SECRET=
INSTANCE_ID=
DATABASE_URL=mysql://shopware:${DB_PASSWORT}@database:3306/shopware
MAILER_DSN=smtp://mailer:1025
BLUE_GREEN_DEPLOYMENT=0
LOCK_DSN=flock
OPENSEARCH_URL=http://localhost:9200
SHOPWARE_ES_ENABLED=0
SHOPWARE_ES_INDEXING_ENABLED=0
SHOPWARE_ES_INDEX_PREFIX=sw
SHOPWARE_ES_THROW_EXCEPTION=1
SHOPWARE_HTTP_CACHE_ENABLED=0
SHOPWARE_HTTP_DEFAULT_TTL=7200
###< Shopware ###

###> Ketteler ###
# Passwort für den Admin-Benutzer "admin" (lokal). Leer lassen: make setup erzeugt eines.
SHOP_ADMIN_PASSWORT=

# Bibliothek für „Jetzt lesen“ (ohne Schrägstrich am Ende). Lokal ein Platzhalter,
# später https://ketteler-verlag.de/bibliothek
KETTELER_BIBLIOTHEK_URL=https://bibliothek.ketteler.test/bibliothek

# Anmeldung über ZITADEL. URL = Adresse für den Browser (Aussteller), INTERN = Adresse vom
# Shop-Container aus (leer, wenn gleich). Client-ID und Organisation stehen in der Plugin-Konfiguration.
KETTELER_ZITADEL_URL=http://localhost:8080
KETTELER_ZITADEL_INTERN=http://zitadel:8080
# Nur lokal: Zugangsschlüssel des Einrichtungskontos (legt ZITADEL beim ersten Start an)
KETTELER_ZITADEL_PAT_DATEI=/zitadel-bootstrap/einrichtung.pat
# Passwort der lokalen Testkunden in ZITADEL (testkunde@ketteler.test)
KETTELER_TESTKUNDE_PASSWORT=

# Lizenz-Schnittstelle des Redaktionssystems. Lokal die Attrappe im Container lizenz-attrappe.
KETTELER_LIZENZ_URL=http://lizenz-attrappe:8090/api/shop/ereignisse
KETTELER_LIZENZ_GEHEIMNIS=
# Hierhin gehen Meldungen, wenn eine Lizenz nicht angelegt werden konnte (lokal: Mailpit)
KETTELER_VERWALTUNG_EMAIL=verwaltung@ketteler.test
###< Ketteler ###

###> ZITADEL (nur lokal) ###
ZITADEL_PORT=8080
ZITADEL_MASTERKEY=
ZITADEL_DB_PASSWORT=
ZITADEL_ADMIN_PASSWORT=
ATTRAPPE_PORT=8090
###< ZITADEL (nur lokal) ###
