{
    "name": "ketteler/shop",
    "license": "proprietary",
    "type": "project",
    "require": {
        "composer-runtime-api": "^2.0",
        "shopware/administration": "6.6.10.29",
        "shopware/core": "6.6.10.29",
        "shopware/elasticsearch": "6.6.10.29",
        "shopware/storefront": "6.6.10.29",
        "symfony/flex": "~2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "custom/plugins/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "custom/plugins/*/packages/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "custom/static-plugins/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "composer",
            "url": "https://shopware.github.io/conflicts/"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "auto-scripts": {
            "assets:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "endpoint": [
                "https://raw.githubusercontent.com/shopware/recipes/flex/main/index.json",
                "flex://defaults"
            ]
        }
    },
    "description": "Ketteler-Shop (Shopware 6)",
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Ketteler\\Anmeldung\\": "custom/plugins/KettelerAnmeldung/src/",
            "Ketteler\\Anmeldung\\Tests\\": "custom/plugins/KettelerAnmeldung/tests/",
            "Ketteler\\Lizenzen\\": "custom/plugins/KettelerLizenzen/src/",
            "Ketteler\\Lizenzen\\Tests\\": "custom/plugins/KettelerLizenzen/tests/"
        }
    }
}
