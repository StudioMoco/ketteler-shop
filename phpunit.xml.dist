<?xml version="1.0" encoding="UTF-8"?>
<!-- Unit-Tests der eigenen Plugins (ohne Datenbank). Aufruf: make test -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory="var/cache/phpunit">
    <testsuites>
        <testsuite name="Ketteler">
            <directory>custom/plugins/KettelerAnmeldung/tests</directory>
            <directory>custom/plugins/KettelerLizenzen/tests</directory>
            <directory>custom/plugins/KettelerMehrplatz/tests</directory>
            <directory>custom/plugins/KettelerSteuern/tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
