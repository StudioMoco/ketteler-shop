{% sw_extends '@Storefront/storefront/page/account/index.html.twig' %}

{# Übersicht aufgeräumt: zuerst die Online-Zugänge, kein Newsletter- und kein Zahlungsart-Kasten #}
{% block page_account_overview_welcome %}
    {{ parent() }}
    {% set ktWerke = ketteler_meine_werke(context.customer) %}
    {% if ktWerke is not empty %}
        <div class="mb-4">
            {% sw_include '@KettelerLizenzen/storefront/component/ketteler/jetzt-lesen.html.twig' with { werke: ktWerke } %}
            <a class="d-inline-block mt-2" href="{{ path('frontend.ketteler.online-zugaenge') }}">{{ 'ketteler.lizenz.alleZugaenge'|trans|sw_sanitize }}</a>
        </div>
    {% endif %}
{% endblock %}

{% block page_account_overview_payment %}{% endblock %}
{% block page_account_overview_newsletter %}{% endblock %}
