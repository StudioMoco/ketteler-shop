{
  "name": "KettelerTheme",
  "author": "Studio Moco",
  "views": [
    "@Storefront",
    "@Plugins",
    "@KettelerTheme"
  ],
  "style": [
    "app/storefront/src/scss/overrides.scss",
    "@Storefront",
    "app/storefront/src/scss/base.scss"
  ],
  "script": [
    "@Storefront"
  ],
  "asset": [
    "@Storefront",
    "app/storefront/src/assets"
  ],
  "previewMedia": "public/logo/ketteler-logo.png",
  "config": {
    "blocks": {
      "ketteler": {
        "label": {
          "de-DE": "Ketteler",
          "en-GB": "Ketteler"
        }
      }
    },
    "fields": {
      "sw-color-brand-primary": {
        "value": "#b7005c"
      },
      "sw-color-brand-secondary": {
        "value": "#1b1b1d"
      },
      "sw-border-color": {
        "value": "#e6e6e9"
      },
      "sw-background-color": {
        "value": "#ffffff"
      },
      "sw-color-success": {
        "value": "#0f766e"
      },
      "sw-color-info": {
        "value": "#2b6cb0"
      },
      "sw-color-warning": {
        "value": "#b4541a"
      },
      "sw-color-danger": {
        "value": "#b42318"
      },
      "sw-text-color": {
        "value": "#1b1b1d"
      },
      "sw-headline-color": {
        "value": "#1b1b1d"
      },
      "sw-color-price": {
        "value": "#1b1b1d"
      },
      "sw-color-buy-button": {
        "value": "#b7005c"
      },
      "sw-color-buy-button-text": {
        "value": "#ffffff"
      },
      "sw-font-family-base": {
        "value": "'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif"
      },
      "sw-font-family-headline": {
        "value": "'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif"
      },
      "ketteler-bibliothek-url": {
        "label": {
          "de-DE": "Adresse der Bibliothek",
          "en-GB": "Library URL"
        },
        "type": "url",
        "value": "https://ketteler-verlag.de/bibliothek/",
        "editable": true,
        "block": "ketteler",
        "scss": false
      }
    }
  }
}
