{
  "name": "KettelerTheme",
  "author": "Studio Moco",
  "views": [
    "@Storefront",
    "@Plugins",
    "@KettelerTheme"
  ],
  "style": [
    "app/storefront/src/scss/overrides.scss",
    "@Storefront",
    "app/storefront/src/scss/base.scss"
  ],
  "script": [
    "@Storefront"
  ],
  "asset": [
    "@Storefront",
    "app/storefront/src/assets"
  ],
  "previewMedia": "public/logo/ketteler-logo.png",
  "config": {
    "fields": {
      "sw-color-brand-primary": {
        "value": "#b7005c"
      },
      "sw-color-brand-secondary": {
        "value": "#4e4447"
      },
      "sw-border-color": {
        "value": "#e8e0d4"
      },
      "sw-background-color": {
        "value": "#fbf8f3"
      },
      "sw-color-success": {
        "value": "#0f766e"
      },
      "sw-color-info": {
        "value": "#2b6cb0"
      },
      "sw-color-warning": {
        "value": "#b4541a"
      },
      "sw-color-danger": {
        "value": "#b42318"
      },
      "sw-text-color": {
        "value": "#2a2326"
      },
      "sw-headline-color": {
        "value": "#2a2326"
      },
      "sw-color-price": {
        "value": "#2a2326"
      },
      "sw-color-buy-button": {
        "value": "#b7005c"
      },
      "sw-color-buy-button-text": {
        "value": "#ffffff"
      },
      "sw-font-family-base": {
        "value": "'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif"
      },
      "sw-font-family-headline": {
        "value": "'IBM Plex Serif', Georgia, 'Times New Roman', serif"
      }
    }
  }
}
