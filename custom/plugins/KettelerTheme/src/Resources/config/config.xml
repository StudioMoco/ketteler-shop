<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">
    <card>
        <title>Contact and service (header and footer)</title>
        <title lang="de-DE">Kontakt und Service (Kopf und Fuß)</title>
        <input-field type="text">
            <name>firma</name>
            <label>Company</label>
            <label lang="de-DE">Firma</label>
            <defaultValue>KETTELER-Verlag GmbH</defaultValue>
        </input-field>
        <input-field type="text">
            <name>anschrift</name>
            <label>Address</label>
            <label lang="de-DE">Anschrift (Fuß, Kontakt)</label>
            <defaultValue>Schloßhof 1, 93449 Waldmünchen</defaultValue>
        </input-field>
        <input-field type="text">
            <name>telefonNummer</name>
            <label>Phone</label>
            <label lang="de-DE">Telefon (Anzeige)</label>
            <defaultValue>09972-9414-51</defaultValue>
        </input-field>
        <input-field type="text">
            <name>telefonWahl</name>
            <label>Phone for dialing</label>
            <label lang="de-DE">Telefon zum Wählen (international, ohne Leerzeichen, mit +)</label>
            <defaultValue>tel:+499972941451</defaultValue>
        </input-field>
        <input-field type="text">
            <name>fax</name>
            <label>Fax</label>
            <label lang="de-DE">Fax</label>
            <defaultValue>09972-9414-55</defaultValue>
        </input-field>
        <input-field type="text">
            <name>email</name>
            <label>E-mail</label>
            <label lang="de-DE">E-Mail-Adresse</label>
            <defaultValue>kontakt@ketteler-verlag.de</defaultValue>
        </input-field>
        <input-field type="text">
            <name>zeitenTage1</name>
            <label>Service days 1</label>
            <label lang="de-DE">Servicezeiten: Tage 1</label>
            <defaultValue>Montag, Dienstag, Donnerstag</defaultValue>
        </input-field>
        <input-field type="text">
            <name>zeitenUhr1</name>
            <label>Service hours 1</label>
            <label lang="de-DE">Servicezeiten: Uhrzeit 1</label>
            <defaultValue>von 8.00 bis 13.00 Uhr</defaultValue>
        </input-field>
        <input-field type="text">
            <name>zeitenTage2</name>
            <label>Service days 2</label>
            <label lang="de-DE">Servicezeiten: Tage 2</label>
            <defaultValue>Mittwoch und Freitag</defaultValue>
        </input-field>
        <input-field type="text">
            <name>zeitenUhr2</name>
            <label>Service hours 2</label>
            <label lang="de-DE">Servicezeiten: Uhrzeit 2</label>
            <defaultValue>von 8.00 bis 12.00 Uhr</defaultValue>
        </input-field>
        <input-field type="text">
            <name>fussZeile</name>
            <label>Footer note</label>
            <label lang="de-DE">Hinweis (Fuß unten rechts)</label>
            <defaultValue>Klimafreundlicher Versand · GoGreen Plus</defaultValue>
        </input-field>
        <input-field type="url">
            <name>bibliothekUrl</name>
            <label>Library link</label>
            <label lang="de-DE">Link „Zur Bibliothek“</label>
            <helpText lang="de-DE">Leer: Adresse der Bibliothek aus der Server-Einstellung KETTELER_BIBLIOTHEK_URL (dieselbe wie bei „Jetzt lesen“).</helpText>
        </input-field>
        <component name="sw-entity-single-select">
            <name>kontaktKategorie</name>
            <entity>category</entity>
            <label>Contact page</label>
            <label lang="de-DE">Seite „Kontakt“ (Kategorie)</label>
        </component>
    </card>
</config>
