{% sw_extends '@Storefront/storefront/layout/header/header.html.twig' %}

{# Kopf nach docs/design/kopf-fuss.md: Logo, Suche, „Anmelden“ bzw. Kontomenü, „Warenkorb“ mit Zähler. #}
{% block layout_header_actions_account %}
    <div class="col-auto">
        <div class="account-menu">
            {% if context.customer and not context.customer.guest %}
                {% sw_include '@Storefront/storefront/layout/header/actions/account-widget.html.twig' %}
            {% else %}
                <a class="kt-kopf-link" href="{{ path('frontend.account.login.page') }}" data-kt="anmelden">Anmelden</a>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block layout_header_actions_cart %}
    <div class="col-auto">
        <div class="header-cart" data-off-canvas-cart="true" data-off-canvas-cart-options="{{ { autoFocus: true }|json_encode }}">
            <a class="btn header-cart-btn header-actions-btn kt-kopf-link"
               href="{{ path('frontend.checkout.cart.page') }}"
               data-cart-widget="true"
               aria-labelledby="cart-widget-aria-label"
               aria-haspopup="dialog">
                {% sw_include '@Storefront/storefront/layout/header/actions/cart-widget.html.twig' %}
            </a>
        </div>
    </div>
{% endblock %}
