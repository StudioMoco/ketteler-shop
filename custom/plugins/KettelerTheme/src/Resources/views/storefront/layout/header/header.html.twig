{% sw_extends '@Storefront/storefront/layout/header/header.html.twig' %}

{# Link zur Bibliothek (Adresse aus KETTELER_BIBLIOTHEK_URL, Funktion aus dem Plugin KettelerLizenzen) #}
{% block layout_header_actions_account %}
    <div class="col-auto d-none d-md-block">
        <a class="kt-kopf-bibliothek" href="{{ ketteler_bibliothek_url() }}">{{ 'ketteler.kopf.bibliothek'|trans|sw_sanitize }}</a>
    </div>
    {{ parent() }}
{% endblock %}
