{% sw_extends '@Storefront/storefront/layout/navigation/flyout.html.twig' %}

{# Untermenü als schlichte Liste (kein Mega-Menü): Übersicht der Kategorie und ihre direkten Unterkategorien #}
{% block layout_navigation_flyout %}
    {% set category = navigationTree.category %}
    <div class="kt-flyout">
        <ul class="kt-flyout-liste">
            {% if category.type == 'page' %}
                <li class="kt-flyout-alles"><a href="{{ category_url(category) }}">Alles zu {{ category.translated.name }}</a></li>
            {% endif %}
            {% for kind in navigationTree.children %}
                <li><a href="{{ category_url(kind.category) }}"{% if category_linknewtab(kind.category) %} target="_blank" rel="noopener"{% endif %}>{{ kind.category.translated.name }}</a></li>
            {% endfor %}
        </ul>
        <button type="button" class="kt-flyout-schliessen js-close-flyout-menu" aria-label="Menü schließen">×</button>
    </div>
{% endblock %}
