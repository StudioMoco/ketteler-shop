{% sw_extends '@Storefront/storefront/layout/header/logo.html.twig' %}

{# Logo fest aus dem Theme, nicht über die Medienverwaltung. Vorläufig PNG, bis Ketteler eine SVG liefert. #}
{% block layout_header_logo_image %}
    {% set service = kt_service(context.salesChannel.id) %}
    <picture class="header-logo-picture d-inline-block">
        <img src="{{ asset(service.logo, 'asset') }}" alt="KETTELER-Verlag"
             width="{{ service.logoBreite }}" height="{{ service.logoHoehe }}"
             class="img-fluid header-logo-main-img" data-kt="logo">
    </picture>
{% endblock %}
