{% sw_extends '@Storefront/storefront/layout/header/top-bar.html.twig' %}

{# Servicezeile statt Sprach- und Währungswahl (Shop nur Deutsch und Euro). Werte aus Erweiterungen > Ketteler Theme. #}
{% block layout_header_top_bar %}
    {% set service = kt_service(context.salesChannel.id) %}
    <div class="top-bar kt-servicezeile">
        <div class="kt-servicezeile-innen">
            <span><span class="kt-servicezeile-zeiten">Servicezeiten: {{ service.servicezeiten }} · </span>Tel. <a href="{{ service.telefonWahl }}">{{ service.telefonNummer }}</a></span>
            <span class="kt-servicezeile-links">
                <a class="kt-servicezeile-bibliothek" href="{{ service.bibliothekUrl }}" data-kt="zur-bibliothek">Zur Bibliothek</a>
                <a href="{{ service.kontaktUrl }}">Kontakt</a>
            </span>
        </div>
    </div>
{% endblock %}
