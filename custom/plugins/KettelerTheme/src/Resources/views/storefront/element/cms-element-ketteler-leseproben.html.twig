{#
    Leseproben (Werkseiten): Fläche Rosé, Sand oder Blaugrau. Links Überschrift, Text, optional Knopf (z. B. Lesemuster)
    und weißer Kasten mit Punkten, rechts die PDF-Dateien aus den Medien mit Kürzel und Titel. Dateien ohne Medium
    erscheinen ohne Link (Platzhalter, bis Ketteler die Datei liefert).
#}
{% set c = element.config %}
{# Leer gelassen (z. B. auf einer Werkseite ohne diesen Bereich): nichts anzeigen #}
{% if c.ueberschrift.value or c.dateien.value is not empty %}
{% set d = element.data %}
{% set knopf = c.knopfDatei.value and d.medien[c.knopfDatei.value] is defined ? d.medien[c.knopfDatei.value] : null %}
<section class="kt-flaeche kt-flaeche--{{ c.flaeche.value|default('rose') }}"{% if c.anker.value %} id="{{ c.anker.value }}"{% endif %} aria-label="{{ c.ueberschrift.value|striptags }}" data-kt="leseproben">
    <div class="kt-rahmen kt-leseproben">
        <div class="kt-leseproben-kopf">
            {% if c.ueberschrift.value %}<h2>{{ c.ueberschrift.value }}</h2>{% endif %}
            {% if c.text.value %}<p class="kt-leseproben-text">{{ c.text.value|kt_text }}</p>{% endif %}
            {% if c.knopfText.value and knopf %}<a class="kt-knopf kt-knopf--rand" href="{{ knopf.url }}" data-kt="leseprobe">{{ c.knopfText.value }}</a>{% endif %}
            {% if c.kastenTitel.value %}
                <div class="kt-leseproben-kasten">
                    {% if c.kastenDachzeile.value %}<p class="kt-dachzeile">{{ c.kastenDachzeile.value }}</p>{% endif %}
                    <p class="kt-leseproben-kasten-titel">{{ c.kastenTitel.value }}</p>
                    <ul>{% for punkt in (c.kastenPunkte.value|default(''))|split("\n") %}{% if punkt|trim %}<li>{{ punkt|trim }}</li>{% endif %}{% endfor %}</ul>
                </div>
            {% endif %}
        </div>
        {% set dateien = c.dateien.value|default([])|filter(e => e.titel) %}
        {% if dateien is not empty %}
            <ul class="kt-leseproben-liste">
                {% for e in dateien %}
                    {% set m = e.datei and d.medien[e.datei] is defined ? d.medien[e.datei] : null %}
                    <li>
                        {% if m %}<a class="kt-leseprobe" href="{{ m.url }}" data-kt="leseprobe">{% else %}<span class="kt-leseprobe">{% endif %}
                            <span class="kt-leseprobe-name">{% if e.kuerzel %}<span class="kt-leseprobe-kuerzel">{{ e.kuerzel }}</span>{% endif %}<span>{{ e.titel }}</span></span>
                            <span class="kt-leseprobe-art">PDF</span>
                        {% if m %}</a>{% else %}</span>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</section>
{% endif %}
