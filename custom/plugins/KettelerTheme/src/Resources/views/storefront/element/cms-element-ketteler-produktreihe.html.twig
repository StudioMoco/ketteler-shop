{#
    Produktreihe („Weitere Empfehlungen“): Überschrift, Link rechts und die gewählten Produkte als Produktkarten
    (dieselbe Karte wie in allen Produktlisten, component/product/card/box-standard.html.twig). Mobil als waagerecht
    scrollbare Reihe mit Einrasten.
#}
{% set c = element.config %}
{% set d = element.data %}
<section class="kt-band--weiss" aria-labelledby="kt-reihe-{{ element.id }}">
    <div class="kt-rahmen kt-produktreihe">
        <div class="kt-kopfzeile">
            <h2 id="kt-reihe-{{ element.id }}">{{ c.ueberschrift.value }}</h2>
            {% if c.linkText.value and kt_link(c.link.value) %}<a class="kt-textlink kt-textlink--magenta" href="{{ kt_link(c.link.value) }}">{{ c.linkText.value }}</a>{% endif %}
        </div>
        <ul class="kt-karten-raster kt-karten-raster--reihe">
            {% for pid in c.produkte.value|default([]) %}
                {% set produkt = d.produkte[pid] ?? null %}
                {% if produkt %}
                    <li data-kt="buch">{% sw_include '@Storefront/storefront/component/product/card/box-standard.html.twig' with { product: produkt } %}</li>
                {% endif %}
            {% endfor %}
        </ul>
    </div>
</section>
