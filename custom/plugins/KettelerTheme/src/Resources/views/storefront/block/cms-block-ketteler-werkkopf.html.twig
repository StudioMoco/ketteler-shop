{# Block mit genau einem Element (ketteler-werkkopf); Gestaltung im Element, docs/design/werkseite-*-entwurf.dc.html #}
{% block block_ketteler_werkkopf %}
    {% set element = block.slots.getSlot('inhalt') %}
    {% if element %}
        <div class="cms-element-ketteler" data-cms-element-id="{{ element.id }}">
            {% sw_include '@Storefront/storefront/element/cms-element-ketteler-werkkopf.html.twig' ignore missing with { element: element } %}
        </div>
    {% endif %}
{% endblock %}
